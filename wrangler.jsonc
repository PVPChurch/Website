// Cloudflare deployment. Workers Builds runs `npm run build` then `npx wrangler deploy`
// on every commit to main. See "How it runs" in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pvpsite",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // Only the contact form needs the Worker; everything else is served as static files.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  // Cloudflare Email Service. The free plan can only send to addresses verified in
  // Email Routing, which is all we need: Contact Messages go to one church mailbox.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // Must be on the domain onboarded to Email Sending (README step 6).
    "CONTACT_FROM": "website@partickvictoriaparkchurch.uk"
  },
  // Two settings are Secrets, set on the Worker in the Cloudflare dashboard (Settings →
  // Variables and Secrets, NOT the Build section) or with `npx wrangler secret put`:
  // - TURNSTILE_SECRET_KEY, from the Turnstile widget.
  // - CONTACT_TO, the church inbox Contact Messages go to. It must be a verified
  //   destination address in Email Routing itself: Cloudflare won't send to an Email
  //   Routing address like contact@ that only forwards there. It's a Secret so the real
  //   inbox address stays out of this public repo.
  // Secrets survive deploys; plain variables set in the dashboard don't.

  "observability": { "enabled": true }
}
