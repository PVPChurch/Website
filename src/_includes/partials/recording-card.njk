{#- Expects `r` (a normalised recording); `cardHeading` sets the heading level (default 3).
    The only link goes straight to the video on YouTube (docs/adr/0004); CSS stretches it over the whole card.
    The date block is for sighted readers; screen readers get the date from the link text. -#}
{%- set hl = cardHeading or 3 -%}
<article class="card recording-card">
  <div class="card-body">
    <h{{ hl }} class="card-title"><a href="{{ r.watchUrl }}">
      {%- if r.sermonTitle %}{{ r.sermonTitle }}<span class="visually-hidden">, {{ r.displayDate }}</span>
      {%- else %}Sunday service<span class="visually-hidden">, {{ r.displayDate | replace("Sunday ", "") }}</span>{% endif -%}
    </a></h{{ hl }}>
    {#- The Bible Passages if there are any, otherwise the date (already in the link text for screen readers). #}
    {%- if r.passages.length %}
    <p class="meta">{{ r.passages | join("; ") }}</p>
    {%- else %}
    <p class="meta" aria-hidden="true">{{ r.displayDate | replace("Sunday ", "") }}</p>
    {%- endif %}
  </div>
  <p class="date-block" aria-hidden="true"><span class="day">{{ r.calendar.day }}</span> <span class="month">{{ r.calendar.month }}</span> <span class="year">{{ r.calendar.year }}</span></p>
</article>
