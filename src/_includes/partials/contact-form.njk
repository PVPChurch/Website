{% if site.turnstileSiteKey %}
<form class="contact-form" action="/api/contact" method="post">
  <p>
    <label for="contact-name">Your name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100">
  </p>
  <p>
    <label for="contact-email">Your email address</label>
    <span class="hint" id="contact-email-hint">So we can reply to you.</span>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="contact-email-hint">
  </p>
  <p>
    <label for="contact-message">Your message</label>
    <textarea id="contact-message" name="message" rows="8" required maxlength="5000"></textarea>
  </p>

  {#- Spam bots fill in every field; people never see this one. -#}
  <p class="trap" aria-hidden="true">
    <label for="contact-website">Leave this empty</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off">
  </p>

  <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-theme="light"></div>
  <noscript><p>This form needs JavaScript to check you're not a robot. You can phone us on {{ site.phone }} instead.</p></noscript>

  <p class="privacy">Your message is emailed to the church office. It isn't stored on this website.</p>
  <p><button type="submit">Send message</button></p>
</form>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% else %}
<p class="notice">The contact form isn't switched on yet. Please phone us on {{ site.phone }}.</p>
{% endif %}
