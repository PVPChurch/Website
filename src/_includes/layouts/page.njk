---
layout: layouts/base.njk
---
<article class="page">
  <h1>{{ entry.title }}</h1>
  <div class="prose">
    {%- if entry.photo %}
    {#- Floats to the right of the text from tablet width up; above the text on phones. #}
    <div class="page-photo"><img src="{{ entry.photo.image }}" alt="{{ entry.photo.description }}" sizes="(min-width: 48rem) 22rem, 100vw"></div>
    {%- endif %}
    {#- Editors' text: cleaned so it can't add scripts or other unsafe HTML (lib/sanitize.js). #}
    {{ content | cleanEditorHtml | safe }}
  </div>
  {%- if entry.contactForm %}
  {% include "partials/contact-form.njk" %}
  {%- endif %}
</article>

{%- if entry.photos.length %}
<ul class="gallery photo-grid" aria-label="Photos">
  {%- for photo in entry.photos %}
  <li><img src="{{ photo.image }}" alt="{{ photo.description }}" sizes="(min-width: 72rem) 17rem, (min-width: 40rem) 33vw, 100vw"></li>
  {%- endfor %}
</ul>
{%- endif %}
