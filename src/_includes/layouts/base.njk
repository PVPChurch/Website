<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or (site.name + ', a ' + site.denomination + ' congregation in Partick, Glasgow.') }}">
  {%- if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <script type="module" src="/assets/js/watch-live.js"></script>
  {%- if site.webAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.webAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>
        {#- The Church of Scotland's own emblem: never redraw or recolour it. Its meaning is in the text beside it. #}
        <img eleventy:ignore src="/assets/images/church-of-scotland.svg" alt="" width="50" height="63">
        <span class="brand-text">
          <span class="brand-name">{{ site.name | keepName | safe }}</span>
          <span class="brand-sub">{{ site.denomination }}</span>
        </span>
      </a>
      <nav aria-label="Main">
        <ul class="menu">
          {%- for item in collections.menu %}
          <li><a href="{{ item.url }}"{% if item.url | isCurrent(page.url) %} aria-current="{{ 'page' if item.url == page.url else 'true' }}"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <div class="wrap">
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>
        <strong>{{ site.name }}</strong><br>
        {{ site.address | join(", ") }}<br>
        Phone: <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
      </p>
      <p>
        {{ site.denomination }}<br>
        Scottish Charity No: {{ site.charityNumber }}<br>
        <a href="https://app.pagescms.org">Editor sign-in</a> · <a href="/editing-guide/">Editing guide</a>
      </p>
    </div>
  </footer>
</body>
</html>
