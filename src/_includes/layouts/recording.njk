---
layout: layouts/base.njk
---
{%- set r = recording -%}
<article class="recording">
  <h1>{{ r.headline }}</h1>
  <p class="meta">
    <time datetime="{{ r.isoDate }}">{{ r.displayDate }}</time>
    {%- if r.series %} · Part of <a href="/series/{{ r.seriesSlug }}/">{{ r.series }}</a>{% endif %}
  </p>

  <div class="video">
    <iframe src="{{ r.embedUrl }}" title="Video of the service: {{ r.headline }}" loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>

  {% if r.passages.length %}
  <h2>Bible {{ "passages" if r.passages.length > 1 else "passage" }}</h2>
  <ul class="passages">
    {%- for passage in r.passages %}
    <li>{% if passage.url %}<a href="{{ passage.url }}">{{ passage.text }}<span class="visually-hidden"> ({{ site.bibleVersion }}, on BibleGateway)</span></a>{% else %}{{ passage.text }}{% endif %}</li>
    {%- endfor %}
  </ul>
  {% endif %}

  <p><a href="{{ r.watchUrl }}">Watch this service on YouTube</a></p>
  <p><a href="/recordings/">All service recordings</a></p>
</article>
