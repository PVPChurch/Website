---
layout: layouts/base.njk
title: Home
---
{%- set latest = collections.recordings[0] -%}
<div class="home">
  <section class="hero on-accent" aria-labelledby="welcome-heading">
    <div class="hero-text">
      <h1 id="welcome-heading">{{ home.heading | keepName | safe }}</h1>
      {{ home.intro | renderContent("md") | safe }}
      <p class="buttons">
        <a class="button" href="/contact/">Find us</a>
        {%- if latest %}
        <a class="button secondary" href="{{ latest.url }}">Watch the latest service</a>
        {%- endif %}
      </p>
    </div>
    <img src="/assets/images/church.jpg" alt="The church building on Dumbarton Road, with its lawn and tree in front" width="960" height="720" loading="eager" sizes="(min-width: 72rem) 36rem, 100vw">
  </section>
  <p class="credit">Photo: <a href="https://commons.wikimedia.org/wiki/File:Partick_South_Parish_Church.jpg">NickGeorge1993</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></p>

  {#- Shown only on Sunday mornings, by assets/js/watch-live.js. Without JavaScript it stays hidden,
      and the "Watch on YouTube" link in the header still works. -#}
  <watch-live day="{{ site.watchLive.day }}" from="{{ site.watchLive.from }}" until="{{ site.watchLive.until }}" time-zone="{{ site.timeZone }}" hidden>
    <section class="live-banner on-accent" aria-labelledby="live-heading">
      <h2 id="live-heading">Our Sunday service is on now</h2>
      <p><a class="button" href="https://www.youtube.com/{{ site.youtube.handle }}/live">Watch live on YouTube</a></p>
    </section>
  </watch-live>

  {% if home.services.length %}
  <section class="service-times" aria-labelledby="times-heading">
    <h2 id="times-heading">Join us on Sundays</h2>
    {%- for service in home.services %}
    <p><strong>{{ service.time }}</strong> {{ service.description }}</p>
    {%- endfor %}
  </section>
  {% endif %}

  {% if latest %}
  <section aria-labelledby="watch-heading">
    <div class="section-head">
      <h2 id="watch-heading">Watch our services</h2>
      <a href="/recordings/">All service recordings</a>
    </div>
    <p>Our Sunday morning service is streamed live on <a href="https://www.youtube.com/{{ site.youtube.handle }}">YouTube</a> every Sunday. Missed one? Watch it again here.</p>
    <ul class="cards recording-list">
      {%- for item in collections.recordings.slice(0, 3) %}
      <li>{% set r = item.data.recording %}{% set url = item.url %}{% include "partials/recording-card.njk" %}</li>
      {%- endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="panels" aria-label="More about the church">
    {%- for item in collections.featured %}
    <div class="panel">
      <h2>{{ item.data.entry.title }}</h2>
      {% if item.data.entry.summary %}<p>{{ item.data.entry.summary }}</p>{% endif %}
      <p><a href="{{ item.url }}">Find out more<span class="visually-hidden"> about {{ item.data.entry.title }}</span></a></p>
    </div>
    {%- endfor %}
    <div class="panel">
      <h2>Baptisms, weddings and funerals</h2>
      <p>For anything at all, send us a message and we'll get back to you, or phone <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>.</p>
      <p><a href="/contact/">Contact us</a></p>
    </div>
  </section>
</div>
