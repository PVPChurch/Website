{
  "name": "pvpsite",
  "private": true,
  "description": "Website for Partick Victoria Park Church",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "test": "node --test",
    "import-recordings": "node scripts/import-recordings.js",
    "import-recordings:dry-run": "node scripts/import-recordings.js --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "axe-core": "^4.14.0",
    "sanitize-html": "^2.18.1",
    "wrangler": "^4.153.0"
  }
}
